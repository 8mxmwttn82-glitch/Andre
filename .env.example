# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional automated form relay (disabled by default while email is turned off)
RESEND_API_KEY=""
CONTACT_TO=""
CONTACT_FROM=""
MAIL_PROVIDER="auto"
ALLOW_MOCK_EMAIL="false"
